/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Cancer Bulk RNA-Seq Analysis Pipeline with Ancestry Integration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Comprehensive tumor RNA-seq pipeline with genetic ancestry inference,
    differential expression, immunogenomics, and pharmacogenomics.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params
params {

    // ---- INPUT ----
    input                      = null  // Path to samplesheet CSV
    outdir                     = './results'

    // ---- REFERENCE GENOME ----
    genome                     = 'GRCh38'
    fasta                      = null
    fasta_fai                  = null
    gtf                        = null
    gene_bed                   = null
    star_index                 = null
    known_snps                 = null      // dbSNP VCF for variant calling
    known_snps_tbi             = null
    graf_snp_bed               = null      // GRAF-pop ancestry-informative SNP positions

    // ---- GENOME BUILD DETECTION & LIFTOVER ----
    // Auto-detect genome build from BAM headers (hg19/GRCh37 vs hg38/GRCh38)
    // and liftover using CrossMap if needed.
    // Most tools in this pipeline work best with GRCh38. Tools that require
    // specific builds: GATK (either), arcasHLA (GRCh38), Arriba (GRCh38),
    // FusionCatcher (either), somalier (either with matching sites VCF).
    // CrossMap handles transcriptomic BAM liftover including spliced alignments.
    target_genome_build        = 'hg38'    // 'hg38' or 'hg19' - target build for analysis
    chain_file                 = null      // Chain file for liftover (e.g., hg19ToHg38.over.chain.gz)
    auto_detect_build          = true      // Auto-detect BAM genome build from header
    force_liftover             = false     // Force liftover even if build matches

    // ---- SAMPLESHEET COLUMNS ----
    // Required: sample_id, bam, bai
    // Optional covariates: batch, sex, age, tumor_purity, cytomolecular_subgroup,
    //   relapse_status, adi_quartile, timepoint, disease_stage, blast_percentage

    // ---- MODULE TOGGLES ----
    run_qc                     = true
    run_ancestry               = true
    run_counting               = true
    run_variant_calling        = true
    run_de                     = true
    run_splicing               = true
    run_fusions                = true
    run_cnv_inference          = true
    run_wgcna                  = true
    run_pathway                = true
    run_immune                 = true
    run_hla                    = true
    run_neoantigen             = true
    run_tcr                    = true
    run_sensitivity            = true
    run_pharmacogenomics       = true
    run_molecular_subtyping    = true
    run_reporting              = true

    // ---- QC ----
    skip_rseqc                 = false
    skip_picard                = false

    // ---- COUNTING (featureCounts / Subread) ----
    fc_extra_attributes        = 'gene_name'
    fc_group_features          = 'gene_id'
    fc_count_type              = 'exon'
    fc_strandedness            = 2       // 0=unstranded, 1=stranded, 2=reversely stranded
    min_mapped_reads           = 500000
    min_gene_counts            = 10      // Min counts across samples to keep gene
    min_samples_expressing     = 3       // Min samples with counts > 0

    // ---- NORMALIZATION ----
    normalization_method       = 'vst'   // 'vst', 'rlog', 'tmm', 'tpm'

    // ---- DIFFERENTIAL EXPRESSION ----
    de_tool                    = 'both'  // 'deseq2', 'limma', 'both'
    padj_threshold             = 0.05
    lfc_threshold              = 0.585   // log2(1.5)

    // Covariates to include in DE model (comma-separated)
    // For B-ALL: include blast_percentage, cytomolecular_subgroup (for overall), timepoint
    de_covariates              = 'batch,sex,age,blast_percentage,tumor_purity,timepoint'

    // Differential contrasts (JSON file or inline)
    // Each contrast: { name, variable, reference, target, subset_var, subset_val }
    de_contrasts               = null    // Path to contrasts JSON file

    // Cytomolecular subgroups for within-group analyses
    cytomolecular_subgroups    = null    // Comma-separated list

    // ---- ANCESTRY ----
    ancestry_reference_panel   = null    // Path to reference panel VCF
    ancestry_reference_labels  = null    // Population labels for reference
    graf_ancestry_categories   = 'EUR,AFR_AM,LA1,LA2,EAS,SAS'
    ancestry_continuous_vars   = 'pct_african,pct_amerindigenous,pct_south_asian,pct_east_asian,pct_european'

    // ---- SPLICING ----
    splicing_tool              = 'rmats' // 'rmats', 'leafcutter', 'both'
    rmats_read_length          = 150
    rmats_novel_ss             = true
    leafcutter_min_coverage    = 20

    // ---- FUSIONS ----
    fusion_tool                = 'both'  // 'fusioncatcher', 'arriba', 'both'
    fusioncatcher_data         = null    // FusionCatcher database directory
    arriba_blacklist           = null
    arriba_known_fusions       = null
    min_fusion_reads           = 3

    // ---- VARIANT CALLING ----
    variant_caller             = 'gatk'  // GATK HaplotypeCaller RNA-seq mode
    min_base_quality           = 20
    min_mapping_quality        = 20
    dbsnp                      = null
    intervals                  = null    // Target regions BED

    // ---- CNV INFERENCE ----
    cnv_tool                   = 'infercnv'  // 'infercnv' or 'casper'
    cnv_reference_group        = null         // Normal reference group
    cnv_gene_order_file        = null

    // ---- WGCNA ----
    wgcna_min_module_size      = 30
    wgcna_merge_cut_height     = 0.25
    wgcna_soft_power           = null    // Auto-detect if null
    wgcna_network_type         = 'signed'
    wgcna_tom_type             = 'signed'

    // ---- PATHWAY ENRICHMENT ----
    pathway_databases          = 'GO_BP,GO_MF,KEGG,REACTOME,HALLMARK,IMMUNESIGDB'
    msigdb_species             = 'Homo sapiens'
    gsea_min_size              = 15
    gsea_max_size              = 500
    run_gsva                   = true

    // ---- IMMUNE ANALYSIS ----
    immune_deconv_methods      = 'cibersortx,xcell,mcpcounter,estimate,epic,timer'
    cibersortx_token           = null    // CIBERSORTx API token (required)
    cibersortx_sigmatrix       = 'LM22'
    estimate_platform          = 'illumina'
    correct_tumor_purity       = true

    // ---- HLA TYPING ----
    hla_tool                   = 'arcashla' // 'arcashla', 'optitype', 'both'
    arcashla_genes             = 'A,B,C,DPB1,DQB1,DQA1,DRB1'

    // ---- NEOANTIGEN PREDICTION ----
    neoantigen_tool            = 'pvacseq'  // 'pvacseq', 'neofuse', 'both'
    pvac_algorithms            = 'MHCflurry,NetMHCpan,NetMHCIIpan'
    binding_threshold          = 500    // nM
    percentile_threshold       = 2.0
    min_variant_depth          = 10
    min_vaf                    = 0.05

    // ---- TCR/BCR REPERTOIRE ----
    tcr_tool                   = 'trust4'

    // ---- SENSITIVITY ANALYSIS ----
    sensitivity_variables      = 'timepoint,ancestry_proportion'
    sensitivity_timepoints     = 'diagnostic,relapse'
    bootstrap_iterations       = 1000

    // ---- PHARMACOGENOMICS ----
    drug_response_db           = 'GDSC'   // 'GDSC', 'CCLE', 'PRISM', 'all'
    drugbank_data              = null
    dgidb_interactions         = true
    cmap_signatures            = null

    // ---- MOLECULAR SUBTYPING ----
    subtyping_method           = 'consensus' // Cancer-type dependent

    // ---- BATCH CORRECTION ----
    batch_correction           = 'combat_seq' // 'combat_seq', 'sva', 'none'
    batch_variable             = 'batch'

    // ---- REPORTING ----
    multiqc_config             = null
    email                      = null

    // ---- RESOURCE DEFAULTS ----
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'
}

// Load base, module, and container configs
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/containers.config'

// Profiles
profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        podman.enabled         = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    slurm {
        includeConfig 'conf/profiles/slurm.config'
    }
    lsf {
        includeConfig 'conf/profiles/lsf.config'
    }
    test {
        includeConfig 'conf/profiles/test.config'
    }
    local {
        includeConfig 'conf/profiles/local.config'
    }
}

// Execution reports
def timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${timestamp}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag_${timestamp}.html"
}

// Capture exit codes from upstream processes
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Disable process selector warnings
nextflow.enable.configProcessNamesValidation = false

manifest {
    name            = 'cancer-rnaseq-ancestry-pipeline'
    author          = 'Cancer Genomics Lab'
    description     = 'Comprehensive cancer bulk RNA-seq pipeline with ancestry inference, immunogenomics, and pharmacogenomics'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
