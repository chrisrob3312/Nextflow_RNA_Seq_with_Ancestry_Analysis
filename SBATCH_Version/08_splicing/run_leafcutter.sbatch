#!/bin/bash
# ============================================================================
# DIFFERENTIAL SPLICING ANALYSIS WITH LEAFCUTTER
# ============================================================================
# Extracts splice junctions using regtools, clusters them with LeafCutter,
# and performs differential splicing analysis between groups.
# ============================================================================

#SBATCH --job-name=leafcutter
#SBATCH --output=logs/leafcutter_%j.out
#SBATCH --error=logs/leafcutter_%j.err
#SBATCH --time=08:00:00
#SBATCH --mem=32G
#SBATCH --cpus-per-task=8
#SBATCH --partition=normal
#SBATCH --account=your_account

# --- Source shared configuration ---
source "$(dirname "$0")/../config.sh"

set -euo pipefail

# --- Load required modules ---
# module load regtools/1.0.0
# module load leafcutter/0.2.9
# module load R/4.3.0
# module load python/3.10
# module load samtools/1.18

log_step "leafcutter" "Starting LeafCutter splicing analysis"

# --- Create output directories ---
OUTDIR="${RESULTS_DIR}/splicing/leafcutter"
JUNC_DIR="${OUTDIR}/junctions"
mkdir -p "${OUTDIR}" "${JUNC_DIR}"

# --- Step 1: Extract junctions for each sample using regtools ---
log_step "leafcutter" "Extracting splice junctions with regtools"

JUNC_LIST="${OUTDIR}/junction_files.txt"
> "${JUNC_LIST}"

mapfile -t SAMPLE_IDS < <(get_sample_ids)

for SAMPLE_ID in "${SAMPLE_IDS[@]}"; do
    BAM_FILE=$(get_bam_for_sample "${SAMPLE_ID}")
    check_file_exists "${BAM_FILE}" "BAM file for ${SAMPLE_ID}"

    JUNC_FILE="${JUNC_DIR}/${SAMPLE_ID}.junc"

    regtools junctions extract \
        -s "${FC_STRANDEDNESS}" \
        -a 8 \
        -m 50 \
        -M 500000 \
        "${BAM_FILE}" \
        > "${JUNC_FILE}"

    echo "${JUNC_FILE}" >> "${JUNC_LIST}"
    log_step "leafcutter" "Extracted junctions for ${SAMPLE_ID}"
done

# --- Step 2: Cluster junctions with LeafCutter ---
log_step "leafcutter" "Clustering junctions with LeafCutter"

cd "${OUTDIR}"

leafcutter_cluster_regtools.py \
    -j "${JUNC_LIST}" \
    -m "${LEAFCUTTER_MIN_COV}" \
    -l 500000

# --- Step 3: Create groups file for differential splicing ---
GROUPS_FILE="${OUTDIR}/groups_file.txt"
> "${GROUPS_FILE}"

while IFS=',' read -r sample_id bam bai condition rest; do
    [[ "${sample_id}" == "sample_id" ]] && continue  # skip header
    if [[ "${condition}" == "relapse" || "${condition}" == "no_relapse" ]]; then
        echo "${sample_id} ${condition}" >> "${GROUPS_FILE}"
    fi
done < "${SAMPLESHEET}"

if [[ ! -s "${GROUPS_FILE}" ]]; then
    echo "ERROR: No samples found for differential splicing groups" >&2
    exit 1
fi

log_step "leafcutter" "Created groups file with $(wc -l < "${GROUPS_FILE}") samples"

# --- Step 4: Run differential splicing analysis ---
log_step "leafcutter" "Running LeafCutter differential splicing"

# Find the clustered counts file (generated by leafcutter_cluster_regtools.py)
COUNTS_FILE=$(find "${OUTDIR}" -name "*perind_numers.counts.gz" | head -1)

if [[ -z "${COUNTS_FILE}" ]]; then
    echo "ERROR: Could not find clustered counts file" >&2
    exit 1
fi

leafcutter_ds.R \
    --num_threads "${SLURM_CPUS_PER_TASK}" \
    "${COUNTS_FILE}" \
    "${GROUPS_FILE}"

log_step "leafcutter" "LeafCutter analysis complete"
log_step "leafcutter" "Output directory: ${OUTDIR}"

echo "Done: LeafCutter - $(date)"
