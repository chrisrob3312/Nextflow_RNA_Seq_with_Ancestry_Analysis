/*
    Test profile - minimal resources for CI/CD
*/
params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Use bundled test data
    input  = "${projectDir}/assets/test_samplesheet.csv"
    outdir = './results_test'

    // Disable resource-intensive modules for testing
    run_wgcna              = false
    run_cnv_inference      = false
    run_neoantigen         = false
    run_pharmacogenomics   = false
    run_sensitivity        = false
    run_molecular_subtyping = false
}
