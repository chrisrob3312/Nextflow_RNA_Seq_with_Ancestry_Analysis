/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module-specific publish directory configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ---- QC ----
    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [ path: { "${params.outdir}/qc/samtools" }, mode: 'copy' ]
    }
    withName: 'SAMTOOLS_IDXSTATS' {
        publishDir = [ path: { "${params.outdir}/qc/samtools" }, mode: 'copy' ]
    }
    withName: 'SAMTOOLS_STATS' {
        publishDir = [ path: { "${params.outdir}/qc/samtools" }, mode: 'copy' ]
    }
    withName: 'RSEQC_.*' {
        publishDir = [ path: { "${params.outdir}/qc/rseqc" }, mode: 'copy' ]
    }
    withName: 'PICARD_COLLECTRNASEQMETRICS' {
        publishDir = [ path: { "${params.outdir}/qc/picard" }, mode: 'copy' ]
    }
    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/qc/multiqc" }, mode: 'copy' ]
    }

    // ---- COUNTING ----
    withName: 'SUBREAD_FEATURECOUNTS' {
        publishDir = [ path: { "${params.outdir}/counting/featurecounts" }, mode: 'copy' ]
    }
    withName: 'NORMALIZE_COUNTS' {
        publishDir = [ path: { "${params.outdir}/counting/normalized" }, mode: 'copy' ]
    }
    withName: 'BATCH_CORRECTION' {
        publishDir = [ path: { "${params.outdir}/counting/batch_corrected" }, mode: 'copy' ]
    }

    // ---- ANCESTRY ----
    withName: 'SOMALIER_EXTRACT|SOMALIER_RELATE' {
        publishDir = [ path: { "${params.outdir}/ancestry/somalier" }, mode: 'copy' ]
    }
    withName: 'EXTRACT_GRAF_SNPS' {
        publishDir = [ path: { "${params.outdir}/ancestry/graf_snps" }, mode: 'copy' ]
    }
    withName: 'MERGE_GRAF_VCFS' {
        publishDir = [ path: { "${params.outdir}/ancestry/graf_merged" }, mode: 'copy' ]
    }
    withName: 'GRAFANC_RUN' {
        publishDir = [ path: { "${params.outdir}/ancestry/grafanc" }, mode: 'copy' ]
    }
    withName: 'ANCESTRY_INFERENCE' {
        publishDir = [ path: { "${params.outdir}/ancestry/proportions" }, mode: 'copy' ]
    }

    // ---- VARIANT CALLING ----
    withName: 'GATK_SPLITNCIGARREADS' {
        publishDir = [ enabled: false ]
    }
    withName: 'GATK_BASERECALIBRATOR|GATK_APPLYBQSR' {
        publishDir = [ enabled: false ]
    }
    withName: 'GATK_HAPLOTYPECALLER' {
        publishDir = [ path: { "${params.outdir}/variant_calling/raw" }, mode: 'copy' ]
    }
    withName: 'GATK_VARIANTFILTRATION' {
        publishDir = [ path: { "${params.outdir}/variant_calling/filtered" }, mode: 'copy' ]
    }
    withName: 'TMB_ESTIMATION' {
        publishDir = [ path: { "${params.outdir}/variant_calling/tmb" }, mode: 'copy' ]
    }
    withName: 'CHASMPLUS' {
        publishDir = [ path: { "${params.outdir}/variant_calling/chasmplus" }, mode: params.publish_dir_mode ]
    }
    withName: 'CREATE_MAF' {
        publishDir = [ path: { "${params.outdir}/variant_calling/maf" }, mode: params.publish_dir_mode ]
    }

    // ---- TUMOR PURITY (ESTIMATE-derived) ----
    withName: 'ESTIMATE_TUMOR_PURITY' {
        publishDir = [ path: { "${params.outdir}/tumor_purity" }, mode: 'copy' ]
    }

    // ---- DE ----
    withName: 'DESEQ2_DE' {
        publishDir = [ path: { "${params.outdir}/differential_expression/deseq2" }, mode: 'copy' ]
    }
    withName: 'LIMMA_VOOM_DE' {
        publishDir = [ path: { "${params.outdir}/differential_expression/limma" }, mode: 'copy' ]
    }

    // ---- SPLICING ----
    withName: 'RMATS' {
        publishDir = [ path: { "${params.outdir}/splicing/rmats" }, mode: 'copy' ]
    }
    withName: 'LEAFCUTTER_.*' {
        publishDir = [ path: { "${params.outdir}/splicing/leafcutter" }, mode: 'copy' ]
    }
    withName: 'SPLADDER_BUILD' {
        publishDir = [ path: { "${params.outdir}/splicing/spladder/graphs" }, mode: 'copy' ]
    }
    withName: 'SPLADDER_TEST' {
        publishDir = [ path: { "${params.outdir}/splicing/spladder/testing" }, mode: 'copy' ]
    }
    withName: 'BISBEE_PREP' {
        publishDir = [ enabled: false ]
    }
    withName: 'BISBEE_DIFF' {
        publishDir = [ path: { "${params.outdir}/splicing/bisbee/differential" }, mode: 'copy' ]
    }
    withName: 'BISBEE_PROT' {
        publishDir = [ path: { "${params.outdir}/splicing/bisbee/protein_effects" }, mode: 'copy' ]
    }
    withName: 'BISBEE_OUTLIER' {
        publishDir = [ path: { "${params.outdir}/splicing/bisbee/outliers" }, mode: 'copy' ]
    }

    // ---- FUSIONS ----
    withName: 'FUSIONCATCHER' {
        publishDir = [ path: { "${params.outdir}/fusions/fusioncatcher" }, mode: 'copy' ]
    }
    withName: 'ARRIBA|ARRIBA_VISUALIZATION' {
        publishDir = [ path: { "${params.outdir}/fusions/arriba" }, mode: 'copy' ]
    }

    // ---- CNV ----
    withName: 'INFERCNV' {
        publishDir = [ path: { "${params.outdir}/cnv_inference" }, mode: 'copy' ]
    }

    // ---- WGCNA ----
    withName: 'WGCNA_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/wgcna" }, mode: 'copy' ]
    }

    // ---- PATHWAY ----
    withName: 'PATHWAY_ENRICHMENT' {
        publishDir = [ path: { "${params.outdir}/pathway_enrichment/ora_gsea" }, mode: 'copy' ]
    }
    withName: 'GSVA_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/pathway_enrichment/gsva" }, mode: 'copy' ]
    }

    // ---- IMMUNE ----
    withName: 'IMMUNE_DECONVOLUTION' {
        publishDir = [ path: { "${params.outdir}/immune_analysis/deconvolution" }, mode: 'copy' ]
    }
    withName: 'ESTIMATE_SCORES' {
        publishDir = [ path: { "${params.outdir}/immune_analysis/estimate" }, mode: 'copy' ]
    }

    // ---- HLA ----
    withName: 'ARCASHLA_.*' {
        publishDir = [ path: { "${params.outdir}/hla_typing/arcashla" }, mode: 'copy' ]
    }
    withName: 'OPTITYPE' {
        publishDir = [ path: { "${params.outdir}/hla_typing/optitype" }, mode: 'copy' ]
    }

    // ---- NEOANTIGEN ----
    withName: 'PVACSEQ|PVACBIND' {
        publishDir = [ path: { "${params.outdir}/neoantigen/pvactools" }, mode: 'copy' ]
    }
    withName: 'NEOFUSE' {
        publishDir = [ path: { "${params.outdir}/neoantigen/neofuse" }, mode: 'copy' ]
    }
    withName: 'SNAF_SPLICING_NEOANTIGENS' {
        publishDir = [ path: { "${params.outdir}/neoantigen/snaf" }, mode: 'copy' ]
    }
    withName: 'MERGE_NEOANTIGENS' {
        publishDir = [ path: { "${params.outdir}/neoantigen/merged" }, mode: 'copy' ]
    }
    withName: 'TELESCOPE_HERV' {
        publishDir = [ path: { "${params.outdir}/neoantigen/herv" }, mode: params.publish_dir_mode ]
    }
    withName: 'HERVQUANT' {
        publishDir = [ path: { "${params.outdir}/neoantigen/hervquant" }, mode: params.publish_dir_mode ]
    }
    withName: 'NEOANTIGEN_BURDEN_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/neoantigen/burden_analysis" }, mode: params.publish_dir_mode ]
    }
    withName: 'ANTIGEN_DB_CROSSREF' {
        publishDir = [ path: { "${params.outdir}/neoantigen/antigen_crossref" }, mode: params.publish_dir_mode ]
    }

    // ---- TCR ----
    withName: 'TRUST4' {
        publishDir = [ path: { "${params.outdir}/tcr_repertoire" }, mode: 'copy' ]
    }

    // ---- SENSITIVITY ----
    withName: 'SENSITIVITY_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/sensitivity_analysis" }, mode: 'copy' ]
    }

    // ---- PHARMACOGENOMICS ----
    withName: 'PHARMACOGENOMICS' {
        publishDir = [ path: { "${params.outdir}/pharmacogenomics" }, mode: 'copy' ]
    }
    withName: 'OCTAD_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/pharmacogenomics/octad" }, mode: params.publish_dir_mode ]
    }
    withName: 'PHARMACOGX_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/pharmacogenomics/pharmacogx" }, mode: params.publish_dir_mode ]
    }
    withName: 'DREAM_DRUGGABILITY' {
        publishDir = [ path: { "${params.outdir}/pharmacogenomics/dream" }, mode: params.publish_dir_mode ]
    }
    withName: 'SIGNATURESEARCH_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/pharmacogenomics/signaturesearch" }, mode: params.publish_dir_mode ]
    }

    // ---- MOLECULAR SUBTYPING ----
    withName: 'MOLECULAR_SUBTYPING' {
        publishDir = [ path: { "${params.outdir}/molecular_subtyping" }, mode: 'copy' ]
    }

    // ---- VALIDATION ----
    withName: 'VALIDATE_DE_CONCORDANCE' {
        publishDir = [ path: { "${params.outdir}/validation/de_concordance" }, mode: 'copy' ]
    }
    withName: 'VALIDATE_SEX_CHECK' {
        publishDir = [ path: { "${params.outdir}/validation/sex_check" }, mode: 'copy' ]
    }
    withName: 'VALIDATE_EXPRESSION_OUTLIERS' {
        publishDir = [ path: { "${params.outdir}/validation/expression_outliers" }, mode: 'copy' ]
    }
    withName: 'VALIDATE_GENOMIC_INFLATION' {
        publishDir = [ path: { "${params.outdir}/validation/genomic_inflation" }, mode: 'copy' ]
    }
    withName: 'COMPILE_VALIDATION_REPORT' {
        publishDir = [ path: { "${params.outdir}/validation" }, mode: 'copy' ]
    }

    // ---- REPORTING ----
    withName: 'GENERATE_REPORT' {
        publishDir = [ path: { "${params.outdir}/report" }, mode: 'copy' ]
    }
    withName: 'VISUALIZATION_SUMMARY' {
        publishDir = [ path: { "${params.outdir}/figures" }, mode: 'copy' ]
    }
    withName: 'COMPILE_PIPELINE_LOG' {
        publishDir = [ path: { "${params.outdir}/pipeline_log" }, mode: 'copy' ]
    }
}
